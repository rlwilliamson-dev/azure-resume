{
  "platform": {
    "apiRuntime": "python:3.11"
  },
  "routes": [
    {
      "route": "/.well-known/security.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      }
    },
    {
      "route": "/robots.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      }
    },
    {
      "route": "/favicon.ico",
      "rewrite": "/favicon.svg",
      "headers": {
        "content-type": "image/svg+xml"
      }
    },
    {
      "route": "/sitemap.xml",
      "headers": {
        "content-type": "application/xml; charset=utf-8"
      }
    },
    {
      "route": "/now",
      "rewrite": "/now.html"
    },
    {
      "route": "/uses",
      "rewrite": "/uses.html"
    },
    {
      "route": "/whoami",
      "rewrite": "/whoami.html"
    },
    {
      "route": "/hall-of-fame",
      "rewrite": "/hall-of-fame.html"
    },
    {
      "route": "/sudo",
      "rewrite": "/sudo.html"
    },
    {
      "route": "/coffee",
      "rewrite": "/coffee.html"
    },
    {
      "route": "/0x00",
      "rewrite": "/0x00.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/api/*",
      "/.well-known/*",
      "/*.{css,js,ico,svg,png,jpg,jpeg,gif,webp,woff,woff2,ttf,otf,txt,xml,html,json}"
    ]
  },
  "globalHeaders": {
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data: https://learn.microsoft.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-origin",
    "Cross-Origin-Embedder-Policy": "credentialless",
    "X-Built-By": "signed commits and weekend hours",
    "X-Hello": "hey curious one: try ryan.help() in the console",
    "X-Easter-Eggs": "FLAG{05_curl_minus_i_is_underrated}; register at https://rlwilliamson.dev/ in the browser console with ryan.found('FLAG{...}'); next stop is short and stout"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".txt": "text/plain; charset=utf-8",
    ".xml": "application/xml; charset=utf-8"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  }
}
