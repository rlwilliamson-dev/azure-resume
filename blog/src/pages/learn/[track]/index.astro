---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopicCard from '../../../components/learn/TopicCard.astro';
import LearnSearch from '../../../components/learn/LearnSearch.astro';
import TerminalHeading from '../../../components/TerminalHeading.astro';
import TrademarkNotice from '../../../components/learn/TrademarkNotice.astro';
import { getLearnTracks, lessonNumbers, type LearnTrack } from '../../../lib/learn';
import { quizSetsForTrack, type QuizSet } from '../../../lib/quiz';
import { collectDistroTables } from '../../../lib/distributions';
import { examFor } from '../../../config/exams';
import { LEARN_BASE } from '../../../config/site';

export async function getStaticPaths() {
  const tracks = await getLearnTracks();
  return tracks.map((track) => ({
    params: { track: track.slug },
    props: {
      track,
      practice: quizSetsForTrack(track.slug),
      // Counted here so the card can name the number, and so a track with no
      // distribution differences does not advertise a page it has no content for.
      distros: collectDistroTables(
        track.topics.map((t) => ({
          title: t.title,
          href: t.href,
          order: t.order,
          body: t.entry.body ?? '',
        }))
      ),
    },
  }));
}

interface Props {
  track: LearnTrack;
  practice: QuizSet[];
  distros: ReturnType<typeof collectDistroTables>;
}
const { track, practice, distros } = Astro.props as Props;
const exam = examFor(track.slug);

/**
 * Study tools only exist for a track with an exam behind it, and the full exam
 * only exists once there are questions to sample.
 */
const tools = exam
  ? [
      {
        href: `${LEARN_BASE}/${track.slug}/plan`,
        title: 'Study plan',
        desc: 'Topics across weeks, with each week returning the following one. Spacing beats cramming.',
      },
      {
        href: `${LEARN_BASE}/${track.slug}/coverage`,
        title: 'Objective coverage',
        desc: `All ${exam.domains.reduce((n, d) => n + d.objectives.length, 0)} ${exam.code} objectives, which are covered, and which are not.`,
      },
      ...(distros.tables.length > 0
        ? [
            {
              href: `${LEARN_BASE}/${track.slug}/distributions`,
              title: 'Distribution differences',
              desc: `All ${distros.rowCount} RHEL and Debian differences from the topics, collected in one place. A vendor-neutral exam tests exactly this.`,
            },
          ]
        : []),
      ...(practice.length > 0
        ? [
            {
              href: `${LEARN_BASE}/${track.slug}/exam`,
              title: 'Full practice exam',
              desc: `Weighted to the real domain percentages and timed to ${exam.minutes} minutes.`,
            },
          ]
        : []),
    ]
  : [];

// Reading order, not grouped by level: a track is a sequence, and a harder
// topic sitting between two easier ones would otherwise render lesson 08 above
// lesson 07. Numbering comes from the same helper the sidebar and the topic
// pages use, so a lesson carries one number everywhere it appears.
const numberOf = lessonNumbers(track.topics);
---
<BaseLayout title={`${track.name} · Learn`} description={track.description || `${track.name} learning notes.`}>
  <p class="learn-crumbs">
    <a href={`${LEARN_BASE}/`}>learn</a>
    <span class="sep">/</span>
    <span>{track.slug}</span>
  </p>

  <TerminalHeading command={`ls ${LEARN_BASE}/${track.slug}`} label={track.name} />
  <p style="color: var(--muted); margin: 0 0 2rem;">
    {track.description}
    <br />
    {track.topics.length} topic{track.topics.length === 1 ? '' : 's'}.
  </p>

  <LearnSearch track={track.slug} placeholder={`Search the ${track.name} notes`} />

  {tools.length > 0 && (
    <section class="learn-tools" aria-labelledby="tools-heading">
      <h2 class="section-h" id="tools-heading">Study tools</h2>
      <ul class="post-list">
        {tools.map((tool) => (
          <li>
            <a class="post-card" href={tool.href}>
              <h3>{tool.title}</h3>
              <p class="desc">{tool.desc}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {practice.length > 0 && (
    <section class="learn-practice" aria-labelledby="practice-heading">
      <h2 class="section-h" id="practice-heading">Practice</h2>
      <ul class="post-list">
        {practice.map((set) => (
          <li>
            <a class="post-card" href={set.href}>
              <h3>{set.bank.title}</h3>
              <div class="meta">
                <span>{set.bank.questions.length} question{set.bank.questions.length === 1 ? '' : 's'}</span>
              </div>
              <p class="desc">{set.bank.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {track.topics.length === 0 ? (
    <p style="color: var(--muted);">No topics in this track yet.</p>
  ) : (
    <section aria-labelledby="lessons-heading">
      <h2 class="section-h" id="lessons-heading">Lessons</h2>
      <ul class="post-list">
        {track.topics.map((topic) => (
          <li>
            <TopicCard topic={topic} number={numberOf.get(topic.slug) ?? ''} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <TrademarkNotice trackName={track.name} footer />
</BaseLayout>
