---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TerminalHeading from '../../components/TerminalHeading.astro';
import { calculateReadingTime } from '../../utils/readingTime';
import { BLOG_BASE } from '../../config/site';

const showDrafts = import.meta.env.DEV;
const allPosts = await getCollection('posts', ({ data }) => showDrafts || !data.draft);

// newest first
const posts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const base = BLOG_BASE;
---
<BaseLayout
  title="Blog · Ryan Williamson"
  description="Writing about Azure, DevOps, infrastructure as code, cybersecurity, and the occasional radio-frequency rabbit hole."
>
  <TerminalHeading command="ls -t /blog" label="Blog" />
  <p style="color: var(--muted); margin: 0 0 2rem;">
    Writing about Azure, DevOps, infrastructure as code, cybersecurity, and the occasional radio-frequency rabbit hole.
    <br />
    <a href={`${base}/rss.xml`}>Subscribe via RSS</a> · <a href={`${base}/tags`}>browse by tag</a>
  </p>

  {posts.length === 0 ? (
    <p style="color: var(--muted);">No posts yet. Check back soon.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <PostCard
            href={`${base}/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            readingTime={calculateReadingTime(post.body)}
            tags={post.data.tags}
            draft={post.data.draft}
          />
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
