---
/**
 * A topic summary for a track index page.
 */
import { formatDate } from '../../utils/dates';
import { LEVEL_LABELS, type LearnTopic } from '../../lib/learn';

interface Props {
  topic: LearnTopic;
  /** Already-formatted display number, from `lessonNumbers`. Orientation is 00. */
  number: string;
}
const { topic, number } = Astro.props;
---
<a class="post-card learn-topic-card" href={topic.href}>
  <h3>
    <span class="learn-topic-index">{number}</span>
    {topic.title}
    {topic.draft && <span class="draft-badge">draft</span>}
  </h3>
  <div class="meta">
    {/* Level was a section heading before the list ran in reading order. It is
        still worth knowing what you are walking into, so it rides on the card. */}
    <span class="learn-level" data-level={topic.level}>{LEVEL_LABELS[topic.level]}</span>
    <span class="dot">·</span>
    <time datetime={topic.updated.toISOString()}>updated {formatDate(topic.updated)}</time>
    {topic.objectives.length > 0 && (
      <>
        <span class="dot">·</span>
        <span>{topic.objectives.length} objective{topic.objectives.length === 1 ? '' : 's'}</span>
      </>
    )}
  </div>
  <p class="desc">{topic.description}</p>
  {topic.tags.length > 0 && (
    <div class="tag-row">
      {topic.tags.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  )}
</a>
