---
/**
 * Full-text search over the learn section, powered by Pagefind.
 *
 * Pagefind indexes the built static output as a post-build step and serves the
 * index as plain files, so this works on the Static Web Apps free tier with no
 * backend and no API calls. We drive the Pagefind JS API directly and render
 * results with the site's own markup rather than loading Pagefind's bundled UI,
 * so search looks like the rest of the site.
 *
 * The index only exists after `astro build`. In `astro dev` there is nothing to
 * load, so the input reports that instead of failing silently.
 */
interface Props {
  /** Restrict results to one track. Omit to search the whole section. */
  track?: string;
  placeholder?: string;
}
const { track, placeholder = 'Search the learn notes' } = Astro.props;
const inputId = track ? `learn-search-${track}` : 'learn-search-all';
---
<div class="learn-search" data-learn-search data-track={track}>
  <label class="learn-search-label" for={inputId}>Search</label>
  <input
    class="learn-search-input"
    id={inputId}
    type="search"
    autocomplete="off"
    placeholder={placeholder}
    data-learn-search-input
  />
  <p class="learn-search-status" data-learn-search-status role="status" aria-live="polite"></p>
  <ul class="learn-search-results" data-learn-search-results></ul>
</div>

{/*
  This script is `is:inline` on purpose.

  Pagefind is generated after `astro build`, so it cannot be resolved at build
  time. A processed script gets its dynamic import rewritten into Vite's
  preload helper, which emits a `__VITE_PRELOAD__` placeholder that is never
  substituted for an ignored import, and the call throws at runtime. Keeping
  the script inline keeps the import literal.

  Inline means no TypeScript and no bundling here, so this is plain JavaScript.
  `type="module"` defers execution until the document is parsed.
*/}
<script type="module" is:inline>
  const MAX_RESULTS = 8;
  let pagefind = null;
  let loadFailed = false;

  async function loadPagefind() {
    if (pagefind || loadFailed) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.options({ excerptLength: 24 });
      return pagefind;
    } catch {
      loadFailed = true;
      return null;
    }
  }

  function escapeAttr(value) {
    return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  }

  for (const root of document.querySelectorAll('[data-learn-search]')) {
    const input = root.querySelector('[data-learn-search-input]');
    const status = root.querySelector('[data-learn-search-status]');
    const list = root.querySelector('[data-learn-search-results]');
    if (!input || !status || !list) continue;

    const track = root.dataset.track;
    let timer;
    let sequence = 0;

    const run = async (query) => {
      const current = ++sequence;

      if (query.trim().length < 2) {
        list.innerHTML = '';
        status.textContent = '';
        return;
      }

      const api = await loadPagefind();
      if (current !== sequence) return;

      if (!api) {
        list.innerHTML = '';
        status.textContent =
          'Search index not available. It is generated by "npm run build", so it is missing during "astro dev".';
        return;
      }

      const options = track ? { filters: { track } } : undefined;
      const search = await api.search(query, options);
      if (current !== sequence) return;

      const top = await Promise.all(search.results.slice(0, MAX_RESULTS).map((r) => r.data()));
      if (current !== sequence) return;

      if (top.length === 0) {
        list.innerHTML = '';
        status.textContent = `No matches for "${query}".`;
        return;
      }

      status.textContent = `${search.results.length} match${
        search.results.length === 1 ? '' : 'es'
      } for "${query}".`;

      list.innerHTML = top
        .map((item) => {
          const title = item.meta.title ?? item.url;
          const trackLabel = item.meta.track ? `<span class="tag">${escapeAttr(item.meta.track)}</span>` : '';
          return `<li class="learn-search-result">
            <a href="${escapeAttr(item.url)}">
              <span class="learn-search-result-title">${escapeAttr(title)}</span>
              ${trackLabel}
            </a>
            <p class="learn-search-result-excerpt">${item.excerpt}</p>
          </li>`;
        })
        .join('');
    };

    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      const value = input.value;
      timer = window.setTimeout(() => run(value), 150);
    });

    // Warm the index on first focus so the first keystroke feels immediate.
    input.addEventListener('focus', () => void loadPagefind(), { once: true });
  }
</script>
