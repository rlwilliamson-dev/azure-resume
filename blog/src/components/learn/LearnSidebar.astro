---
/**
 * Track navigation for a topic page. Every topic in the current track in
 * reading order, with the current page marked. Built entirely from the
 * collection.
 *
 * Reading order, not grouped by level: a track is a sequence, and difficulty is
 * a property of a lesson rather than a section of the syllabus. Grouping put
 * lesson 08 above lesson 07 whenever a harder topic sat between two easier
 * ones, which is exactly the flow the numbering exists to show.
 *
 * No level badge here. It was tried, and on a 77-topic track it competed with
 * the title for a narrow column and pushed names onto three and four lines.
 * The topic header and the track index card both show level, which is where
 * somebody is actually choosing what to read.
 *
 * On narrow viewports this collapses into a disclosure. The markup ships open
 * so it still works with JavaScript disabled; a small script closes it on small
 * screens, where the summary is the only visible part until tapped.
 */
import { lessonNumbers, lessonCount, type LearnTopic } from '../../lib/learn';

interface Props {
  trackName: string;
  trackHref: string;
  topics: LearnTopic[];
  currentSlug: string;
}
const { trackName, trackHref, topics, currentSlug } = Astro.props;

/** Reading-order numbers. Orientation pages number 00. */
const numberOf = lessonNumbers(topics);

/**
 * Counted in lessons, matching the "Lesson 7 of 9" line on the page itself.
 * Counting array positions instead would include the orientation page and
 * disagree with the header on every lesson.
 */
const current = topics.find((t) => t.slug === currentSlug);
const positionLabel = !current
  ? ''
  : current.beyondExam
    ? 'beyond the exam'
    : current.orientation
      ? 'start here'
      : `${Number(numberOf.get(currentSlug))} of ${lessonCount(topics)}`;
---
<details class="learn-nav" open>
  <summary class="learn-nav-summary">
    <span class="learn-nav-summary-label">{trackName} contents</span>
    <span class="learn-nav-summary-count">{positionLabel}</span>
  </summary>

  <nav class="learn-nav-body" aria-label={`${trackName} track`}>
    <a class="learn-nav-track" href={trackHref}>{trackName}</a>

    <ul class="learn-nav-list">
      {topics.map((topic) => (
        <li>
          <a
            href={topic.href}
            class:list={['learn-nav-link', { 'is-current': topic.slug === currentSlug }]}
            aria-current={topic.slug === currentSlug ? 'page' : undefined}
          >
            <span class="learn-nav-num" aria-hidden="true">{numberOf.get(topic.slug)}</span>
            <span class="learn-nav-title">{topic.title}</span>
            {topic.draft && <span class="learn-nav-draft">draft</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</details>

<script>
  // The sidebar is open in the markup so it works without JavaScript. On narrow
  // viewports collapse it, so the topic starts at the top of the screen.
  const narrow = window.matchMedia('(max-width: 900px)');
  const nav = document.querySelector<HTMLDetailsElement>('.learn-nav');

  function sync(matches: boolean) {
    if (!nav) return;
    nav.open = !matches;
  }

  if (nav) {
    sync(narrow.matches);
    narrow.addEventListener('change', (event) => sync(event.matches));
  }
</script>
