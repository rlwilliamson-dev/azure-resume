---
// Sticky site header for the blog.
// The "home" link goes to the main resume site (rlwilliamson.dev),
// the "blog" link goes to /blog (base path is set in astro.config.mjs).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="site-header">
  <div class="site-header-inner">
    <a class="site-logo" href="/">rlwilliamson</a>
    <nav class="site-nav" aria-label="primary">
      <a href={`${base}/`}>blog</a>
      <a href="/now">now</a>
      <a href="/uses">uses</a>
      <a href="/">resume</a>
    </nav>
    <button class="theme-toggle" id="themeBtn" type="button" aria-label="Toggle light or dark theme">☀ light</button>
  </div>
</header>

<script is:inline>
  // Apply saved theme on first paint to avoid flash
  (function () {
    try {
      const saved = localStorage.getItem('theme');
      if (saved === 'light') document.documentElement.setAttribute('data-theme', 'light');
    } catch (e) {}
  })();
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('themeBtn');
    if (!btn) return;
    const sync = () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      btn.textContent = isLight ? '☾ dark' : '☀ light';
    };
    sync();
    btn.addEventListener('click', () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      const next = isLight ? 'dark' : 'light';
      if (next === 'light') document.documentElement.setAttribute('data-theme', 'light');
      else document.documentElement.removeAttribute('data-theme');
      try { localStorage.setItem('theme', next); } catch (e) {}
      sync();
    });
  });
</script>
