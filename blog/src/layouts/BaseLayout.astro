---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, BLOG_BASE, canonicalFor } from '../config/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  /** Widen the main column. Used by learn topic pages, which carry a sidebar. */
  wide?: boolean;
}
const { title, description, ogImage, canonical, wide } = Astro.props;
const siteUrl = SITE_URL;
const fullTitle = title.endsWith('Ryan Williamson') ? title : `${title} · Ryan Williamson`;
const desc = description ?? 'Writing about Azure, DevOps, infrastructure as code, and security.';
const og = ogImage ?? `${siteUrl}/me.jpg`;
const canonicalUrl = canonical ?? canonicalFor(Astro.url.pathname);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#050810" />
  <link rel="canonical" href={canonicalUrl} />
  <title>{fullTitle}</title>

  <!-- Open Graph -->
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="rlwilliamson.dev" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={og} />

  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/me.jpg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- JetBrains Mono carries its italic axis because the learn panels set
       commands in bold italic. Without it the browser synthesises a slant,
       which on a monospace face reads as a smeared upright rather than a
       designed italic. -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400;1,700&display=swap" rel="stylesheet" />

  <!-- RSS autodiscovery -->
  <link rel="alternate" type="application/rss+xml" title="rlwilliamson.dev blog" href={`${siteUrl}${BLOG_BASE}/rss.xml`} />
</head>
<body>
  <Header />
  <main class={wide ? 'container container-wide' : 'container'}>
    <slot />
  </main>
  <div class={wide ? 'container container-wide' : 'container'}>
    <Footer />
  </div>
</body>
</html>
